# Family JARVIS — Environment Variables
# Copy this file to .env and fill in real values
# NEVER commit .env to git
# NEVER put real values in this file

# ─── Supabase ───────────────────────────────────────────────────────────────
# Find these in your Supabase project settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here          # Safe for frontend (subject to RLS)
SUPABASE_SERVICE_ROLE_KEY=your-service-key    # BACKEND ONLY — bypasses RLS — never expose

# ─── OpenRouter ─────────────────────────────────────────────────────────────
# Get your API key at https://openrouter.ai
OPENROUTER_API_KEY=sk-or-your-key-here        # BACKEND ONLY — never expose to browser
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Model configuration — change to any model available on OpenRouter
# Strong reasoning model for Manager and Date Planner
OPENROUTER_MODEL_MANAGER=anthropic/claude-3.5-sonnet
# Fast model for Organizer (structured extraction)
OPENROUTER_MODEL_ORGANIZER=anthropic/claude-3-haiku
# Mid-tier model for Chef recommendations
OPENROUTER_MODEL_CHEF=anthropic/claude-3-sonnet
# Strong model for nuanced Date Planner recommendations
OPENROUTER_MODEL_PLANNER=anthropic/claude-3.5-sonnet
# Fastest/cheapest model for simple tasks
OPENROUTER_MODEL_FAST=anthropic/claude-3-haiku

# ─── ElevenLabs ─────────────────────────────────────────────────────────────
# Get your API key at https://elevenlabs.io
ELEVENLABS_API_KEY=your-elevenlabs-key        # BACKEND ONLY — never expose to browser
ELEVENLABS_VOICE_ID=your-chosen-voice-id      # Choose a voice from ElevenLabs dashboard

# ─── Google Calendar OAuth ───────────────────────────────────────────────────
# Create at https://console.cloud.google.com > APIs & Services > Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret  # BACKEND ONLY — never expose
GOOGLE_REDIRECT_URI=http://localhost:8000/api/calendar/callback/google

# ─── Calendar Token Encryption ───────────────────────────────────────────────
# Used to encrypt OAuth tokens before storing in Supabase
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
CALENDAR_ENCRYPTION_KEY=generate-a-32-byte-hex-key

# ─── Application ─────────────────────────────────────────────────────────────
APP_ENV=development                           # development | production
JARVIS_DEMO=true                              # true = demo mode; false = production
JWT_SECRET=generate-a-secure-random-string   # Used for any additional JWT signing
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── Frontend (safe for browser) ─────────────────────────────────────────────
# These go in frontend/.env (Vite prefix: VITE_)
VITE_API_URL=http://localhost:8000
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here    # Same as SUPABASE_ANON_KEY above
VITE_APP_ENV=development

# ─── Production Only ─────────────────────────────────────────────────────────
# These are set in Render dashboard, not in .env files
# RENDER_SERVICE_ID=
# PRODUCTION_DOMAIN=
